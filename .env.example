# ==============================================================================
# VnSavingPro Environment Variables (Server-Side Only — NEVER expose SERVICE_ROLE in src/)
# Copy this file to `.env.local` for local development, or configure in Vercel Dashboard.
# ==============================================================================

# 1. Supabase Free Tier Project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Anon Key (Settings -> API -> anon public)
SUPABASE_ANON_KEY=your-anon-public-key

# 3. Supabase Service Role Key (Settings -> API -> service_role secret - Vercel Server Only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 4. Optional secret to protect /api/cron/sync-rates on Vercel
CRON_SECRET=

# 5. Public Browser Auth Client Keys (Safe for Vite client bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# 6. Resend Email Delivery (Server-only + Supabase Custom SMTP)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=VnSavingPro <no-reply@your-verified-domain.com>
